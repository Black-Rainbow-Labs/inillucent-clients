<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- The library targets net8.0 so it works on the widest set of runtimes.
         This runner follows it there, and rolls forward to whatever major runtime
         is installed, so the suite runs on a box that only has a newer one. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Inillucent/Inillucent.csproj" />
  </ItemGroup>

</Project>
