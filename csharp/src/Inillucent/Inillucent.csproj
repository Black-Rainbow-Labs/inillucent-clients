<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>Inillucent.Client</PackageId>
    <Version>0.1.0</Version>
    <Description>Client for the Inillucent embedded database, over its stable C ABI.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Black-Rainbow-Labs/inillucent-clients</RepositoryUrl>
    <PackageTags>database;embedded;sql;inillucent</PackageTags>
  </PropertyGroup>

</Project>
